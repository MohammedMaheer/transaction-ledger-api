# Local development examples only. Replace the password for any shared deployment.
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_local_password
POSTGRES_DB=ledger
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://ledger:ledger_local_password@localhost:5432/ledger
# Tests refuse databases whose names do not end with _test. All its tables are truncated.
TEST_DATABASE_URL=postgresql+asyncpg://ledger:ledger_test_password@localhost:5433/ledger_test
LOG_LEVEL=INFO
